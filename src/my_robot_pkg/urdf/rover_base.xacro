<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- =============================================== -->
  <!-- Rover base                                      -->
  <!-- =============================================== -->

  <xacro:macro name="rover_base" params="rover">

    <!-- Body parameters -->

    <xacro:property
      name="body_length"
      value="${rover['body']['length']}"/>

    <xacro:property
      name="body_width"
      value="${rover['body']['width']}"/>

    <xacro:property
      name="body_height"
      value="${rover['body']['height']}"/>

    <xacro:property
      name="body_mass"
      value="${rover['body']['mass']}"/>


    <!-- Wheel parameters -->

    <xacro:property
      name="wheel_radius"
      value="${rover['wheels']['radius']}"/>

    <xacro:property
      name="wheel_width"
      value="${rover['wheels']['width']}"/>

    <xacro:property
      name="wheel_mass"
      value="${rover['wheels']['mass']}"/>

    <xacro:property
      name="wheel_x"
      value="${rover['wheels']['x_offset']}"/>

    <xacro:property
      name="wheel_y"
      value="${rover['wheels']['y_offset']}"/>

    <xacro:property
      name="wheel_z"
      value="${rover['wheels']['z_offset']}"/>




    <!-- ============================================= -->
    <!-- Wheel macro                                   -->
    <!-- ============================================= -->

    <xacro:macro name="wheel" params="name x y">

      <link name="${name}">

        <visual>

          <geometry>
            <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>
          </geometry>

          <material name="black"/>

        </visual>


        <collision>

          <geometry>
            <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>
          </geometry>

        </collision>


        <xacro:cylinder_inertial
          mass="${wheel_mass}"
          radius="${wheel_radius}"
          length="${wheel_width}"/>

      </link>


      <joint name="${name}_joint" type="continuous">

        <parent link="base_link"/>
        <child link="${name}"/>

        <origin
          xyz="${x} ${y} ${wheel_z}"
          rpy="1.5708 0 0"/>

        <axis xyz="0 0 -1"/>

      </joint>

    </xacro:macro>


    <!-- ============================================= -->
    <!-- Base link                                     -->
    <!-- ============================================= -->

    <link name="base_link">

      <visual>

        <geometry>
          <box
            size="${body_length}
                  ${body_width}
                  ${body_height}"/>
        </geometry>

        <material name="blue"/>

      </visual>


      <collision>

        <geometry>
          <box
            size="${body_length}
                  ${body_width}
                  ${body_height}"/>
        </geometry>

      </collision>


      <xacro:box_inertial
        mass="${body_mass}"
        length="${body_length}"
        width="${body_width}"
        height="${body_height}"/>

    </link>


    <!-- ============================================= -->
    <!-- Wheels                                        -->
    <!-- ============================================= -->

    <xacro:wheel
      name="front_left_wheel"
      x="${wheel_x}"
      y="${wheel_y}"/>

    <xacro:wheel
      name="front_right_wheel"
      x="${wheel_x}"
      y="${-wheel_y}"/>

    <xacro:wheel
      name="rear_left_wheel"
      x="${-wheel_x}"
      y="${wheel_y}"/>

    <xacro:wheel
      name="rear_right_wheel"
      x="${-wheel_x}"
      y="${-wheel_y}"/>

  </xacro:macro>

</robot>