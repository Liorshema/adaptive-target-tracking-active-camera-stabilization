<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


  <xacro:macro name="gazebo_plugins" params="rover">

    <xacro:property
      name="wheel_radius"
      value="${rover['wheels']['radius']}"/>

    <xacro:property
      name="wheel_y"
      value="${rover['wheels']['y_offset']}"/>

    <xacro:property
      name="track_width"
      value="${2.0 * wheel_y}"/>


    <!-- ============================================= -->
    <!-- Differential drive                            -->
    <!-- ============================================= -->

    <gazebo>

      <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">

        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>

        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>

        <wheel_separation>${track_width}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>

        <topic>cmd_vel</topic>

        <odom_publish_frequency>50</odom_publish_frequency>

      </plugin>

    </gazebo>


    <!-- ============================================= -->
    <!-- Arm position controllers                      -->
    <!-- ============================================= -->

    <gazebo>
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

        <joint_name>base_yaw_joint</joint_name>
        <topic>/arm/base_yaw/cmd_pos</topic>

        <p_gain>40.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>4.0</d_gain>

        <cmd_max>30.0</cmd_max>
        <cmd_min>-30.0</cmd_min>

      </plugin>
    </gazebo>


    <gazebo>
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

        <joint_name>shoulder_joint</joint_name>
        <topic>/arm/shoulder/cmd_pos</topic>

        <p_gain>100.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>10.0</d_gain>

        <cmd_max>60.0</cmd_max>
        <cmd_min>-60.0</cmd_min>

      </plugin>
    </gazebo>


    <gazebo>
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

        <joint_name>elbow_joint</joint_name>
        <topic>/arm/elbow/cmd_pos</topic>

        <p_gain>70.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>7.0</d_gain>

        <cmd_max>40.0</cmd_max>
        <cmd_min>-40.0</cmd_min>

      </plugin>
    </gazebo>


    <gazebo>
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

        <joint_name>wrist_joint</joint_name>
        <topic>/arm/wrist/cmd_pos</topic>

        <p_gain>40.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>4.0</d_gain>

        <cmd_max>20.0</cmd_max>
        <cmd_min>-20.0</cmd_min>

      </plugin>
    </gazebo>

  </xacro:macro>

</robot>