<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =============================================== -->
  <!-- Rectangular box inertia                         -->
  <!-- =============================================== -->

  <xacro:macro
    name="box_inertial"
    params="mass length width height origin_x:=0 origin_y:=0 origin_z:=0">

    <inertial>

      <origin
        xyz="${origin_x} ${origin_y} ${origin_z}"
        rpy="0 0 0"/>

      <mass value="${mass}"/>

      <inertia
        ixx="${mass / 12.0 * (width**2 + height**2)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass / 12.0 * (length**2 + height**2)}"
        iyz="0.0"
        izz="${mass / 12.0 * (length**2 + width**2)}"/>

    </inertial>

  </xacro:macro>


  <!-- =============================================== -->
  <!-- Solid cylinder inertia                          -->
  <!-- Cylinder symmetry axis = local Z               -->
  <!-- =============================================== -->

  <xacro:macro
    name="cylinder_inertial"
    params="mass radius length origin_x:=0 origin_y:=0 origin_z:=0">

    <inertial>

      <origin
        xyz="${origin_x} ${origin_y} ${origin_z}"
        rpy="0 0 0"/>

      <mass value="${mass}"/>

      <inertia
        ixx="${mass / 12.0 * (3.0 * radius**2 + length**2)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass / 12.0 * (3.0 * radius**2 + length**2)}"
        iyz="0.0"
        izz="${0.5 * mass * radius**2}"/>

    </inertial>

  </xacro:macro>

</robot>