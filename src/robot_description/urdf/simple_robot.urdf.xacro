<?xml version="1.0"?>

<robot
  name="simple_robot"
  xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- =============================================== -->
  <!-- Configuration                                   -->
  <!-- =============================================== -->

  <xacro:arg name="config_file" default=""/>

  <xacro:property
    name="config"
    value="${xacro.load_yaml('$(arg config_file)')}"/>

  <xacro:property
    name="robot"
    value="${config['robot']}"/>


  <!-- =============================================== -->
  <!-- Components                                      -->
  <!-- =============================================== -->

  <xacro:include filename="inertial_macros.xacro"/>
  <xacro:include filename="robot_base.xacro"/>
  <xacro:include filename="robot_arm.xacro"/>
  <xacro:include filename="gazebo_plugins.xacro"/>
  <xacro:include filename="materials.xacro"/>


  <!-- =============================================== -->
  <!-- Robot assembly                                  -->
  <!-- =============================================== -->

  <xacro:robot_base robot="${robot}"/>

  <xacro:robot_arm robot="${robot}"/>

  <xacro:gazebo_plugins robot="${robot}"/>


</robot>