<?xml version="1.0"?>

<sdf version="1.9"
     xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =============================================== -->
  <!-- Terrain configuration                           -->
  <!-- =============================================== -->

  <xacro:arg
    name="terrain_config"
    default=""/>

  <xacro:property
    name="terrain_data"
    value="${xacro.load_yaml('$(arg terrain_config)')}"/>

  <xacro:property
    name="terrain"
    value="${terrain_data['terrain']}"/>

  <xacro:property
    name="ground_mu"
    value="${terrain['friction']['mu']}"/>

  <xacro:property
    name="ground_mu2"
    value="${terrain['friction']['mu2']}"/>


  <world name="greenhouse">

    <!-- ============================================= -->
    <!-- Physics                                       -->
    <!-- ============================================= -->

    <physics
      name="physics"
      type="ode">

      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>

    </physics>


    <!-- ============================================= -->
    <!-- Gravity                                       -->
    <!-- ============================================= -->

    <gravity>0 0 -9.81</gravity>


    <!-- ============================================= -->
    <!-- Light                                         -->
    <!-- ============================================= -->

    <light
      type="directional"
      name="sun">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.1 -0.9</direction>

    </light>


    <!-- ============================================= -->
    <!-- Ground                                        -->
    <!-- ============================================= -->

    <model name="ground_plane">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <surface>

            <friction>

              <ode>
                <mu>${ground_mu}</mu>
                <mu2>${ground_mu2}</mu2>
              </ode>

            </friction>

          </surface>

        </collision>


        <visual name="ground_visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>

        </visual>

      </link>

    </model>

  </world>

</sdf>