<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
           schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>rover_simulation</name>
  <version>0.0.0</version>

  <description>
    Simulation, experiment orchestration, and model comparison for the rover.
  </description>

  <maintainer email="liorshema@gmail.com">user</maintainer>

  <license>Apache-2.0</license>

  <!-- Runtime dependencies -->

  <exec_depend>rclpy</exec_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>message_filters</exec_depend>

  <exec_depend>my_robot_pkg</exec_depend>
  <exec_depend>rover_dynamics</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Testing -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>